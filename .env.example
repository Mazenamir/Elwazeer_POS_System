# ==========================================
# Bebyoon / El-Wazeer POS System Environment
# ==========================================

# Operational Mode: 'server' (Master) or 'branch' (Offline Branch)
APP_MODE=server
PORT=6253
NODE_ENV=production

# Database (PostgreSQL - Master Mode)
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_min_64_chars

# Sync Configuration (Branch <-> Master)
SYNC_TARGET=true
SYNC_SERVER_URL=http://localhost:6253
SYNC_API_KEY=BebyoonSecretKey2026
BRANCH_ID=1
