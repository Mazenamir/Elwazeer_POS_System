{
  "name": "bebyoon-system",
  "version": "1.0.6",
  "description": "Bebyoon / El-Wazeer POS & Management System",
  "main": "src/main/index.js",
  "scripts": {
    "prestart": "node -e \"const fs = require('fs'); if (!fs.existsSync('dist/renderer/index.html')) { require('child_process').execSync('npm run build:client', { stdio: 'inherit' }); }\"",
    "start": "electron .",
    "build": "vite build",
    "server": "node src/server/server.js",
    "dev:client": "vite",
    "dev:electron": "electron . --dev",
    "dev:web": "concurrently -k -n server,client -c blue,green \"npm run server\" \"npm run dev:client\"",
    "dev": "concurrently -k -n server,client,electron -c blue,green,magenta \"npm run server\" \"npm run dev:client\" \"electron . --dev --external-server\"",
    "build:client": "vite build",
    "build:css": "tailwindcss -i ./src/renderer/assets/css/tailwind-input.css -o ./src/renderer/assets/css/tailwind.min.css --minify",
    "prepack": "npm run build:client",
    "pack": "electron-builder --dir",
    "predist": "npm run build:client",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "verify:package": "node scratch/verify_package.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "pg": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.bebyoon.system",
    "productName": "Bebyoon System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/logos/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/shared",
        "to": "shared",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/renderer",
        "to": "dist/renderer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "programs",
        "to": "programs",
        "filter": [
          "**/*",
          "!data/log/**/*",
          "!data/current_logfiles",
          "!data/postmaster.pid",
          "!data/postmaster.opts",
          "!data/*.log",
          "!node/node_modules/**/*"
        ]
      },
      {
        "from": "postgresql",
        "to": "postgresql",
        "filter": [
          "**/*",
          "!pgAdmin 4/**/*",
          "!doc/**/*",
          "!include/**/*",
          "!installer/**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!electron/**/*",
          "!electron-builder/**/*",
          "!vite/**/*",
          "!@vitejs/**/*",
          "!tailwindcss/**/*",
          "!postcss/**/*",
          "!autoprefixer/**/*",
          "!concurrently/**/*",
          "!electron-winstaller/**/*",
          "!@electron/windows-sign/**/*",
          "!@rolldown/**/*",
          "!lightningcss*/**/*",
          "!rolldown/**/*",
          "!.bin/**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bebyoon System",
      "include": "build/installer.nsh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Mazenamir",
      "repo": "Elwazeer_POS_System"
    },
    "electronVersion": "30.0.0"
  }
}
